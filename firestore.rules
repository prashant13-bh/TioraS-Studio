rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Strict Admin Check based on Email
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ph293815@gmail.com' ||
        request.auth.token.email == 'tyoras9686@gmail.com' ||
        request.auth.token.email == 'dsmullam@gmail.com'
      );
    }

    function isVendor() {
      return isSignedIn() && exists(/databases/$(database)/documents/vendors/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/vendors/$(request.auth.uid)).data.status == 'Active';
    }

    // -------------------------------------------------------------------------
    // User Profiles (/users)
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin(); 
      allow create: if isSignedIn(); // Allow any signed in user to create their initial profile
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Vendors (/vendors)
    // -------------------------------------------------------------------------

    match /vendors/{vendorId} {
      allow get: if isSignedIn(); // Allow customers to see vendor profiles
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == vendorId; // Allow users to apply
      allow update: if isAdmin(); // Only admin can approve/suspend
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Products (/products)
    // -------------------------------------------------------------------------

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() || (isVendor() && request.resource.data.vendorId == request.auth.uid);
      allow update: if isAdmin() || (isVendor() && resource.data.vendorId == request.auth.uid);
      allow delete: if isAdmin() || (isVendor() && resource.data.vendorId == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // Stock Movements (/stockMovements)
    // -------------------------------------------------------------------------

    match /stockMovements/{movementId} {
      allow read: if isAdmin() || isVendor(); // Vendors can see their own stock movements if we add vendorId filtering
      allow create: if isAdmin() || isVendor();
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Invoices (/invoices)
    // -------------------------------------------------------------------------

    match /invoices/{invoiceId} {
      allow read: if isAdmin() || (isVendor() && resource.data.vendorId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Addresses (/addresses)
    // -------------------------------------------------------------------------

    match /addresses/{addressId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // -------------------------------------------------------------------------
    // Orders (/orders)
    // -------------------------------------------------------------------------

    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        isAdmin() || 
        (isVendor() && resource.data.vendorId == request.auth.uid)
      );
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isVendor() && resource.data.vendorId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Designs (/designs)
    // -------------------------------------------------------------------------

    match /designs/{designId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // -------------------------------------------------------------------------
    // Carts (/carts)
    // -------------------------------------------------------------------------

    match /carts/{cartId} {
      allow read, write: if isSignedIn() && (request.auth.uid == cartId || isAdmin());
    }

    // -------------------------------------------------------------------------
    // Wishlists (/wishlists)
    // -------------------------------------------------------------------------

    match /wishlists/{wishlistId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // -------------------------------------------------------------------------
    // Reviews (/reviews)
    // -------------------------------------------------------------------------

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
