rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role-based check: Strict Admin by Email
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ph293815@gmail.com' ||
        request.auth.token.email == 'tyoras9686@gmail.com' ||
        request.auth.token.email == 'dsmullam@gmail.com'
      );
    }

    // Role-based check: Active Vendor check in the 'vendors' collection
    function isVendor() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/vendors/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/vendors/$(request.auth.uid)).data.status == 'Active';
    }

    // -------------------------------------------------------------------------
    // User Profiles (/users)
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin(); 
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Vendors (/vendors)
    // -------------------------------------------------------------------------

    match /vendors/{vendorId} {
      // Public can see active store profiles; Admins see all
      allow get: if (resource.data.status == 'Active') || isOwner(vendorId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == vendorId; 
      allow update: if isAdmin() || (isOwner(vendorId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']));
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Products (/products)
    // -------------------------------------------------------------------------

    match /products/{productId} {
      allow read: if true; // Products are public
      
      // Vendors can create/edit/delete their own products; Admins can do anything
      allow create: if isAdmin() || (isVendor() && request.resource.data.vendorId == request.auth.uid);
      allow update, delete: if isAdmin() || (isVendor() && resource.data.vendorId == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // Orders (/orders)
    // -------------------------------------------------------------------------

    match /orders/{orderId} {
      // Users see their own; Vendors see assigned; Admins see all
      allow read: if isAdmin() || 
                     (isSignedIn() && resource.data.userId == request.auth.uid) ||
                     (isVendor() && resource.data.vendorId == request.auth.uid);
      
      allow create: if isSignedIn();
      
      // Status updates only by Admin or the assigned Vendor
      allow update: if isAdmin() || (isVendor() && resource.data.vendorId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Designs (/designs)
    // -------------------------------------------------------------------------

    match /designs/{designId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // Private Collections (Admins & Owners Only)
    // -------------------------------------------------------------------------

    match /addresses/{addressId} {
      allow read, write: if isOwner(resource.data.userId) || isOwner(request.resource.data.userId) || isAdmin();
    }

    match /carts/{cartId} {
      allow read, write: if isOwner(cartId) || isAdmin();
    }

    match /invoices/{invoiceId} {
      // Vendors see invoices for their orders; Admins see all
      allow read: if isAdmin() || (isVendor() && resource.data.vendorId == request.auth.uid);
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Public Collections
    // -------------------------------------------------------------------------

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
  }
}
